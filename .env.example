# Domínio definitivo, sem barra no final. Enquanto não for definido, o site
# gera robots.txt bloqueando a indexação e metatag noindex.
NEXT_PUBLIC_SITE_URL=

# Código de verificação do Google Search Console (método "tag HTML": somente o valor do content).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Token do Cloudflare Web Analytics (estatísticas de visitas sem cookies). Vazio = sem estatísticas.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Defina como "false" para bloquear a indexação mesmo com o domínio configurado (ex.: ambiente de homologação).
NEXT_PUBLIC_ALLOW_INDEXING=

# Defina como "true" para exibir os marcadores de pendência em um build de produção (revisão interna).
NEXT_PUBLIC_SHOW_PENDING=

# --- CMS de artigos (Supabase) -------------------------------------------------
# Valores públicos: vão para o código do navegador. O acesso aos dados é controlado pelas
# políticas de RLS (supabase/migrations), não pelo segredo destas chaves.
#
# Como preencher: copie este arquivo para .env.local (que não vai para o Git) e cole os valores lá.
# No painel do Supabase, abra o projeto e clique em "Connect" (topo da página), ou:
#   URL do projeto  -> Project Settings > Data API > "Project URL"   (ex.: https://abcd1234.supabase.co, sem barra no final)
#   Chave pública   -> Project Settings > API Keys > "Publishable key" (começa com sb_publishable_)
#                      Em projetos antigos, use a chave "anon" (aba Legacy API Keys). Nunca a "service_role"/secret.
# Depois, rode "npm run supabase:verificar" para conferir a conexão.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NÃO coloque aqui (nem em nenhuma variável NEXT_PUBLIC_):
#   - a chave secreta / service_role do Supabase;
#   - o token do GitHub que dispara o deploy;
#   - o segredo do webhook.
# Esses valores ficam somente nos segredos das Edge Functions do Supabase (veja supabase/README.md).
# Se algum segredo for colocado numa variável NEXT_PUBLIC_, o build para com erro antes de gerar o site.
